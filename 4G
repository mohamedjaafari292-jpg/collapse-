#!/data/data/com.termux/files/usr/bin/bash

# --- CONFIGURATION & COLORS ---
R='\e[1;31m'; G='\e[1;32m'; Y='\e[1;33m'; B='\e[1;34m'; P='\e[1;35m'; C='\e[1;36m'; W='\e[1;37m'; NC='\e[0m'
export TERM=xterm-256color

# --- INITIALIZING CORE ---
clear
echo -e "${P}[*] Initializing X-Console Kernel...${NC}"
termux-wake-lock
sleep 1

# --- FUNCTION: ENCRYPTED LOADING EFFECT ---
loading_seq() {
    local msg=$1
    echo -ne "${W}[$msg] "
    for i in {1..20}; do echo -ne "${G}█"; sleep 0.03; done
    echo -e " ${C}DONE${NC}"
}

# --- HEADER: THE OMEGA INTERFACE ---
echo -e "${C}
  █████╗ ██████╗ ██╗   ██╗ █████╗ ███╗   ██╗ ██████╗███████╗██████╗ 
 ██╔══██╗██╔══██╗██║   ██║██╔══██╗████╗  ██║██╔════╝██╔════╝██╔══██╗
 ███████║██║  ██║██║   ██║███████║██╔██╗ ██║██║     █████╗  ██║  ██║
 ██╔══██║██║  ██║╚██╗ ██╔╝██╔══██║██║╚██╗██║██║     ██╔══╝  ██║  ██║
 ██║  ██║██████╔╝ ╚████╔╝ ██║  ██║██║ ╚████║╚██████╗███████╗██████╔╝
 ╚═╝  ╚═╝╚═════╝   ╚═══╝  ╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝╚══════╝╚═════╝ 
             >> SYSTEM OVERRIDE: ULTIMATE EDITION << ${NC}"

echo -e "${B}────────────────────────────────────────────────────────────────${NC}"
loading_seq "ALIGING SATELLITE LINK"
loading_seq "BYPASSING ISP THROTTLE"
loading_seq "INJECTING SOCKET BUFFER"
echo -e "${B}────────────────────────────────────────────────────────────────${NC}"

# --- LIVE SYSTEM MONITOR ---
trap "termux-wake-unlock; echo -e '\n${R}[!] SHUTTING DOWN CORE...${NC}'; exit" SIGINT

while true; do
    # 1. Real Data Gathering
    DATE=$(date +'%H:%M:%S')
    MEM_FREE=$(free -m | awk '/Mem:/ {print $4}')
    CPU_LOAD=$(top -n 1 -b | head -n 3 | tail -n 1 | awk '{print $2}')
    
    # 2. Network Traffic Calculation (Anti-Error)
    RX_1=$(cat /proc/net/dev | grep -E 'wlan0|rmnet|eth0' | awk '{print $2}' | head -n 1)
    [ -z "$RX_1" ] && RX_1=0
    sleep 0.2
    RX_2=$(cat /proc/net/dev | grep -E 'wlan0|rmnet|eth0' | awk '{print $2}' | head -n 1)
    [ -z "$RX_2" ] && RX_2=0
    
    DIFF=$(( (RX_2 - RX_1) / 1024 ))
    
    # 3. Visual "Matrix" Style Output
    CLR=${cols[$((RANDOM % 6))]}
    
    echo -e "${W}[${G}${DATE}${W}] ${C}CPU: ${R}${CPU_LOAD}% ${C}| MEM: ${G}${MEM_FREE}MB ${C}| NET: ${Y}${DIFF} KB/s"
    
    # 4. Simulation of High-End Tasks (The "Cool" Factor)
    case $((RANDOM % 4)) in
        0) echo -e "${P} >> SCANNING VOIP PORT: ${NC}$((RANDOM % 65000)) ${G}[OPEN]${NC}" ;;
        1) echo -e "${B} >> TUNNELING VIA: ${NC}127.0.0.1:${W}$((RANDOM % 9000))${NC}" ;;
        2) echo -e "${R} >> PACKET INJECTION: ${NC}MTU 1500 -> ${G}SUCCESS${NC}" ;;
        3) echo -e "${Y} >> LATENCY OPTIMIZER: ${NC}STABILIZING AT ${G}14ms${NC}" ;;
    esac

    # 5. The "Infinity" Scroll (Optional visual flair)
    if (( DIFF > 50 )); then
        echo -e "${G}⚡ CRITICAL SPEED DETECTED: BOOSTING PACKET PRIORITY ⚡${NC}"
    fi

    # Small delay to keep it readable but fast
    sleep 0.3
done

